{
  "name": "positiveLife4me",
  "short_name": "PL4M",
  "description": "Body. Mind. Soul. Keep moving forward.",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EFE8D6",
  "theme_color": "#DCE8D5",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-run",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
